#!/bin/sh
#
# Git pre-commit hook — Embedded Swift build verification
#
# Automatically verifies that changes made to Sources/WasmRuntime/
# still compile under Embedded Swift before each commit.
# Blocks the commit if compilation fails.
#
# Install: make setup-hooks

# Check if any staged Swift files are under Sources/WasmRuntime/
# Skip if not — avoid overhead for unrelated changes
if ! git diff --cached --name-only | grep -q "^Sources/WasmRuntime/"; then
  exit 0
fi

echo "--- pre-commit: Embedded Swift build verification ---"
make compile
STATUS=$?

if [ $STATUS -ne 0 ]; then
  echo ""
  echo "Error: Embedded Swift compilation failed. Commit aborted."
  echo "  Check that you have not imported frameworks unavailable in Embedded Swift (e.g. Foundation)."
  echo ""
  echo "  To skip: git commit --no-verify (not recommended)"
  exit 1
fi

echo ""
